# Copie este arquivo para backend/.env e preencha. O .env não vai para o git.

# Read API Key do canal (ThingSpeak → canal → aba "API Keys" → "Read API Keys").
# Deixe vazio se só usar canais públicos.
THINGSPEAK_READ_API_KEY=

# Login. JWT_SECRET assina os tokens: use um texto aleatório com 32+ caracteres
# (sem ele, todos precisam entrar de novo sempre que o back-end reinicia).
JWT_SECRET=
# Primeiro administrador, criado só se o banco ainda não tiver usuários.
# Senha vazia = o back-end gera uma e mostra UMA vez no log de inicialização.
ECOSENSE_ADMIN_EMAIL=admin@ecosense.local
ECOSENSE_ADMIN_PASSWORD=

# Banco MySQL. O banco "ecosense" é criado sozinho se não existir.
MYSQL_URL=jdbc:mysql://localhost:3306/ecosense?createDatabaseIfNotExist=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=
