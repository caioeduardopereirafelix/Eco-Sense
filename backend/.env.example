# Copie este arquivo para backend/.env e preencha. O .env não vai para o git.

# Read API Key do canal (ThingSpeak → canal → aba "API Keys" → "Read API Keys").
# Deixe vazio se só usar canais públicos.
THINGSPEAK_READ_API_KEY=

# Banco MySQL (perfil "thingspeak"). O banco "ecosense" é criado sozinho se não existir.
MYSQL_URL=jdbc:mysql://localhost:3306/ecosense?createDatabaseIfNotExist=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=
